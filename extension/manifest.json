{
  "manifest_version": 3,
  "name": "EmotionSense AI Assistant",
  "version": "1.0",
  "description": "AI-powered emotion detection for better learning experiences.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "scripting",
    "contextMenus",
    "videoCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
